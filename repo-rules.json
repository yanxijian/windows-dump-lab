{
  "version": 1,
  "skip_dirs": [
    ".git",
    "build",
    "output"
  ],
  "skip_prefixes": [],
  "skip_globs": [],
  "encoding": [
    {
      "glob": "*.md",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.json",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.yml",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.txt",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.ps1",
      "bom": true,
      "eol": "crlf"
    },
    {
      "glob": "*.cpp",
      "bom": true,
      "eol": "crlf"
    },
    {
      "glob": "*.h",
      "bom": true,
      "eol": "crlf"
    },
    {
      "glob": ".gitignore",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": ".gitattributes",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "LICENSE",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "scripts/repo_rules.py",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": ".githooks/pre-commit",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": ".githooks/commit-msg",
      "bom": false,
      "eol": "lf"
    }
  ],
  "width": {
    "globs": [
      "*.cpp",
      "*.h"
    ],
    "limit": 120,
    "tab_width": 4
  },
  "forbidden": [],
  "headers": {
    "globs": [
      "*.h"
    ],
    "first_line": "#pragma once",
    "forbid_namespace_using": true
  },
  "versions": [],
  "changelog": null,
  "required_files": [
    "README.md",
    "README.zh-CN.md",
    "README.ja.md",
    "README.ko.md",
    "LICENSE",
    "harness/CMakeLists.txt",
    "harness/main.cpp",
    "expected_answers.json",
    "scripts/run_all_cases.ps1",
    "scripts/verify_with_skill.ps1",
    "scripts/gen_expected_answers.ps1",
    "repo-rules.json",
    ".gitattributes",
    "scripts/repo_rules.py",
    ".githooks/pre-commit",
    ".githooks/commit-msg",
    ".github/workflows/hygiene.yml"
  ],
  "markdown": {
    "globs": [
      "*.md"
    ],
    "check_links": true,
    "languages": {
      "default": "README.md",
      "variants": [
        "README.zh-CN.md",
        "README.ja.md",
        "README.ko.md"
      ],
      "switch_line": true,
      "stale": "warning"
    }
  },
  "readme_badges": {
    "files": [
      "README.md",
      "README.zh-CN.md",
      "README.ja.md",
      "README.ko.md"
    ],
    "min": 3,
    "require": [
      "actions/workflows/",
      "img.shields.io/badge/License"
    ]
  },
  "gitattributes": {
    "path": ".gitattributes",
    "required_patterns": [
      "\\* text=auto eol=lf",
      "\\*\\.md\\s+text eol=lf",
      "\\*\\.ps1\\s+text eol=crlf",
      "\\*\\.cpp\\s+text eol=crlf"
    ]
  },
  "about": {
    "description": "30-case C++/Qt fault lab for windows-dump-analysis | windows-dump-analysis 技能的 30 用例 C++/Qt 故障靶场",
    "order": "en-zh"
  },
  "comments": {
    "english": true,
    "allow_marker": "cjk-ok"
  },
  "commit_message": {
    "english": true
  },
  "actions": {
    "require": {
      "actions/checkout": "v7"
    },
    "allow_sha": true
  }
}
